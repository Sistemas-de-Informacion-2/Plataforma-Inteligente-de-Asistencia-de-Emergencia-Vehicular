# ── Backend Dockerfile ────────────────────────────────────────
# Imagen base ligera de Python 3.11
FROM python:3.11-slim

# Variables de entorno globales
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Carpeta de trabajo dentro del contenedor
WORKDIR /app

# Instalar dependencias del sistema necesarias para:
#   - gcc: compilar extensiones C (asyncpg, bcrypt)
#   - libpq-dev: driver nativo de PostgreSQL
#   - ffmpeg: requerido por faster-whisper para procesamiento de audio
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Copiar SOLO requirements primero (cache de Docker)
COPY requirements.txt .

# Instalar dependencias Python
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copiar el resto del código
COPY . .

# Crear directorio de uploads
RUN mkdir -p /app/uploads

# Dar permisos de ejecución al entrypoint
RUN chmod +x /app/entrypoint.sh

# Puerto de FastAPI
EXPOSE 8000

# Entrypoint: espera BD → migra → inicia
ENTRYPOINT ["/app/entrypoint.sh"]
